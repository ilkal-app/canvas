{
  "name": "@canvas/eslint-config",
  "version": "0.0.0",
  "private": true,
  "description": "The shared ESLint flat config for the canvas monorepo, applied once from the root eslint.config.js.",
  "type": "module",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -b",
    "lint": "eslint --max-warnings 0 ."
  },
  "dependencies": {
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-jsdoc": "~63.3.3",
    "typescript-eslint": "^8.70.1"
  },
  "peerDependencies": {
    "eslint": "^10.11.0",
    "typescript": "~5.9.3"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "eslint": "^10.11.0",
    "typescript": "~5.9.3"
  }
}
