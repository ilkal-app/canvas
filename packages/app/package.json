{
  "name": "@canvas/app",
  "version": "0.0.0",
  "private": true,
  "description": "React shell: toolbar, panels, dialogs, shortcuts, theming.",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "vite build && tsc -b",
    "slices": "node --experimental-strip-types scripts/build-cjk-slices.ts",
    "lint": "eslint --max-warnings 0 ."
  },
  "dependencies": {
    "@canvas/collab": "workspace:*",
    "@canvas/document": "workspace:*",
    "@canvas/engine": "workspace:*",
    "@canvas/schema": "workspace:*",
    "@canvas/tools": "workspace:*",
    "@expo-google-fonts/lora": "0.4.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@canvas/text": "workspace:*",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^30.1.1",
    "vite": "^7.3.6"
  }
}
