{
  "name": "ilkal-canvas",
  "version": "0.0.0",
  "private": true,
  "description": "An embeddable infinite canvas: the source of @ilkal/sdk.",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "prepare": "pnpm --filter @canvas/eslint-config run build",
    "build": "pnpm --filter @canvas/app run slices && pnpm -r run build",
    "test": "pnpm --filter @canvas/app run slices && vitest run",
    "lint": "pnpm -r run lint",
    "typecheck": "tsc -b",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "docs": "tsc -b && typedoc",
    "changeset": "changeset",
    "version-packages": "changeset version"
  },
  "devDependencies": {
    "@canvas/eslint-config": "workspace:*",
    "@changesets/cli": "^3.0.3",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^10.11.0",
    "prettier": "^3.9.9",
    "typedoc": "^0.28.20",
    "typescript": "~5.9.3",
    "vite": "^7.3.6",
    "vitest": "^3.2.7"
  }
}
